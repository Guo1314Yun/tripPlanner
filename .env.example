# LLM configuration
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60

# Server configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# External services
AMAP_API_KEY=your_amap_api_key
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
